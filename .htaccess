# Upload this next to sync.php (Apache shared hosting).

# Pass the Authorization header through to PHP (needed on many CGI/FastCGI hosts).
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Block direct downloads of the stored data, lock and temp files.
<FilesMatch "\.(json|lock|tmp)$">
  Require all denied
</FilesMatch>

Options -Indexes
